# IFESS Control Service — Environment Variables
# Copy to .env and adjust values for your environment.

# Port for the IFESS Control Service (default: 8003)
PORT=8003

# API key required for protected endpoints (X-API-Key header)
# Default is for PTRJ development only — change in production!
IFESS_API_KEY=ptrj-rebinmas-air-ruak-parit-gunung-darul

# Optional: override path to the canonical ifess-control-server/service.js
# Default resolves relative to this service's src/ directory.
# SERVICE_PATH=../../../Services/ifess-control-server/service.js
