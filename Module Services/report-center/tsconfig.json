{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": "D:/Gawean Rebinmas/Main Dashboard",
    "paths": {
      "@/*": ["Dashboard_Utama/*"],
      "@modules/*": ["Module Services/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
