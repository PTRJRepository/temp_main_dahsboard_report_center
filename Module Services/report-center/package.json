{
  "name": "report-center-module",
  "version": "0.2.0",
  "private": true,
  "description": "Report Center — standalone Next.js app. Bun start to run independently.",
  "scripts": {
    "dev": "bun --bun next dev --hostname 0.0.0.0 -p 3101",
    "build": "bun --bun next build",
    "start": "bun --bun next start --hostname 0.0.0.0 -p 3101",
    "lint": "bun --bun eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
