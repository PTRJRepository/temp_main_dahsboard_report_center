# IFESS Control Service — Environment Variables
# Copy to .env and adjust values for your environment.

# Port for the IFESS Control Service (default: 8003 — legacy iFESS ControlServer port)
IFESS_PORT=8003

# API key required for protected endpoints (X-API-Key header)
# Must match the key configured in IFESS.SuperApp clients (ControlServerOptions.ApiKey)
IFESS_API_KEY=ptrj-rebinmas-air-ruak-parit-gunung-darul
