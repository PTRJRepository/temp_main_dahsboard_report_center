# =============================================
# sql-gateway module — environment template
# Copy to .env and fill in. NEVER commit .env.
# DB profile format is IDENTICAL to the old
# D:/Tools_Gawe/Database_Query_Gateway/.env so
# you can paste profiles straight over.
# =============================================

# ── HTTP ─────────────────────────────────────
HOST=0.0.0.0
# Port lama SQL Gateway — dipertahankan agar caller eksternal tidak berubah.
PORT=8001

# ── Internal API keys (machine-to-machine) ───
# JSON map: key → { name, readOnly, description }
# readOnly=true  → SELECT-only on every profile
# readOnly=false → full access, but writes/DDL
#                  only on FULLACCESS profile+db
# Generate: openssl rand -hex 24  (or bun -e "console.log(crypto.randomUUID())")
SQLGW_API_KEYS={"CHANGE_ME_key_1":{"name":"report-center","readOnly":true,"description":"Report Center module"},"CHANGE_ME_key_2":{"name":"admin-cli","readOnly":false,"description":"Admin operations"}}

# Legacy single-token compat (old clients of the
# previous gateway). Treated as an admin key named
# "legacy-token". Remove once callers migrated.
# API_TOKEN=paste-old-token-here

# ── Default server profile ───────────────────
DB_PROFILE=SERVER_PROFILE_1

# ── Database profiles (same format as source) ─
# READ_ONLY=true  → server rejects write/DDL ops
DATABASE_PROFILES_SERVER_PROFILE_1_DRIVER="ODBC Driver 17 for SQL Server"
DATABASE_PROFILES_SERVER_PROFILE_1_SERVER=10.0.0.110
DATABASE_PROFILES_SERVER_PROFILE_1_PORT=1433
DATABASE_PROFILES_SERVER_PROFILE_1_USERNAME=sa
DATABASE_PROFILES_SERVER_PROFILE_1_PASSWORD=change-me
DATABASE_PROFILES_SERVER_PROFILE_1_TRUSTED_CONNECTION=false
DATABASE_PROFILES_SERVER_PROFILE_1_ENCRYPT=false
DATABASE_PROFILES_SERVER_PROFILE_1_READ_ONLY=false

DATABASE_PROFILES_SERVER_PROFILE_2_DRIVER="ODBC Driver 17 for SQL Server"
DATABASE_PROFILES_SERVER_PROFILE_2_SERVER=10.0.0.2
DATABASE_PROFILES_SERVER_PROFILE_2_PORT=1888
DATABASE_PROFILES_SERVER_PROFILE_2_USERNAME=sa
DATABASE_PROFILES_SERVER_PROFILE_2_PASSWORD=change-me
DATABASE_PROFILES_SERVER_PROFILE_2_TRUSTED_CONNECTION=false
DATABASE_PROFILES_SERVER_PROFILE_2_ENCRYPT=false
DATABASE_PROFILES_SERVER_PROFILE_2_READ_ONLY=true

# ── Write/DDL window (full access pair) ──────
# Write ops allowed ONLY when BOTH match, and
# only for non-readOnly callers (admin keys or
# portal users with role ADMIN).
SQLGW_FULLACCESS_PROFILE=SERVER_PROFILE_1
SQLGW_FULLACCESS_DB=extend_db_ptrj

# ── Audit log / monitoring ───────────────────
# JSONL sink under <module>/data/logs (gitignored)
SQLGW_LOG_RETENTION_DAYS=14
SQLGW_LOG_MAX_FILE_MB=50
SQLGW_REQUEST_RING=5000
SQLGW_QUERY_RING=3000
SQLGW_SECURITY_RING=1000

# ── Query result cache ───────────────────────
SQLGW_CACHE_TTL_MS=300000

# ── Rate limit (per caller+IP, /v1/* only) ───
SQLGW_RATE_LIMIT_PER_MIN=120

# ── Portal login (for UI 401 fallback link) ──
SQLGW_LOGIN_URL=http://localhost:3001/login
