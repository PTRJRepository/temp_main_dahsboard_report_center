{
  "name": "sql-gateway",
  "version": "1.0.0",
  "description": "Internal SQL Gateway module — MSSQL bridge API with traffic monitoring & audit logging (migrated from D:/Tools_Gawe/Database_Query_Gateway)",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "start:node": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "sql",
    "gateway",
    "mssql",
    "audit",
    "monitoring"
  ],
  "license": "ISC",
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "dotenv": "^16.4.0",
    "fastify": "^5.0.0",
    "mssql": "^11.0.0",
    "node-sql-parser": "^5.3.0"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.8",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
