# RJFM — Rebinmas Jaya File Management
PORT=8011
NODE_ENV=development

# MSSQL (reuse 10.0.0.110:1433, database RJ_FileManagement — create via 02_Database_SQL/schema_database_rjfm.sql)
MSSQL_HOST=10.0.0.110
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=ptrj@123
MSSQL_DATABASE=RJ_FileManagement

# Auth — reuse keys/ if present, else HS256 secret
JWT_SECRET=ptrj-rjfm-dev-secret-2026
JWT_EXPIRES_IN=12h

# Storage — NAS Synology via FileStation HTTP API (bukan SMB drive)
RJFM_NAS_URL=http://10.0.0.8:5000
RJFM_NAS_USER=it
RJFM_NAS_PASS=
# Folder dasar remote di share NAS
RJFM_STORAGE_PATH=/IT/Extend Server Portal/RJFM
RJFM_MAX_FILE_MB=10

# CORS
CORS_ORIGIN=http://localhost:3001

# Gateway NAS — service-to-service API key.
# WAJIB diisi (bebas, cukup panjang/acak): kalau kosong, SELURUH /api/gateway/* merespons 503.
RJFM_API_KEY=
