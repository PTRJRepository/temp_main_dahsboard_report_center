    "IN_MTHENDTRX": {
      "rows": 82194,
      "server": "SERVER_PROFILE_3",
      "primary_key": "(DocId, DocLnId, AccYear, AccMonth) — composite",
      "description": "Monthly transaction journal lines. Double-entry accounting for inventory transactions. Balances stock issues, fuel issues, and adjustments.",
      "columns": [
        {"ordinal": 1,  "name": "DocId",        "type": "char",     "width": 20, "nullable": false, "description": "Document header ID. e.g. SI26016305 (Stock Issue), FI26007327 (Fuel Issue), SA25000034 (Stock Adj)."},
        {"ordinal": 2,  "name": "DocLnId",      "type": "char",     "width": 20, "nullable": false, "description": "Document line ID. e.g. SIL26032485. Format: module prefix + YR + 6-digit."},
        {"ordinal": 3,  "name": "DocType",      "type": "char",     "width": 3,  "nullable": true,  "description": "Document type. '24'=Stock Issue, '25'=Fuel Issue, '20'=Stock Adjustment, '35','149'=rare."},
        {"ordinal": 4,  "name": "DocDate",      "type": "datetime", "nullable": false, "description": "Transaction date."},
        {"ordinal": 5,  "name": "LocCode",       "type": "char",     "width": 8,  "nullable": false, "description": "Location code."},
        {"ordinal": 6,  "name": "ModuleCode",   "type": "char",     "width": 8,  "nullable": false, "description": "Module origin. All = '3' (padded to '3       ') = Inventory module."},
        {"ordinal": 7,  "name": "AccMonth",      "type": "char",     "width": 2,  "nullable": false, "description": "Accounting month (space-padded)."},
        {"ordinal": 8,  "name": "AccYear",       "type": "char",     "width": 4,  "nullable": false, "description": "Accounting year."},
        {"ordinal": 9,  "name": "EmpCode",       "type": "char",     "width": 20, "nullable": false, "description": "Employee code (blank for non-labor transactions)."},
