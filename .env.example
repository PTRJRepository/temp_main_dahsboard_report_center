# Root gateway / dual-mode example
# Copy to local env files as needed. NEVER commit real secrets.
# Last verified: 2026-07-21 against package.json scripts and CLAUDE.md notes.

# --- Runtime ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DASHBOARD_PORT=3100
START_DASHBOARD=true
# START_MODULE_SERVICES=false

# --- Auth / JWT (paths relative to project root) ---
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# AUTH_SECRET=
# NEXTAUTH_SECRET=
# NEXTAUTH_URL=http://localhost:3001
# COOKIE_SECURE=false

# --- IFESS Control (gateway) ---
# IFESS_API_KEY=

# --- Query gateway / Firebird (server_bun) ---
# DB path and isql location are environment-specific; see docs/05-configuration.md
# QUERY_API_KEY=

# --- Upstream service hosts (examples only) ---
# BACKEND_HOST=localhost
# BACKEND_HOST_FALLBACK=localhost

# Dashboard-specific variables live in Dashboard_Utama/.env.local.example
